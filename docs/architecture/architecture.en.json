  "cards": [
    {
      "dot": "amber",
      "title": "Persistent data",
      "items": [
        "SQLite in /data holds the catalog, upload jobs, scan state and library operation journal.",
        "Image files from IGDB are cached under /data/cache/images.",
        "Sessions are stateless HMAC-signed tokens in cookies; they are not SQLite rows."
      ]
    },
    {
      "dot": "cyan",
      "title": "Shared library",
      "items": [
        "The /library dataset is shared over SMB; console folders use n64, gc, wii, switch, ps2 and psp.",
        "The periodic scan discovers settled files copied into console folders and moves unknown files to _unassigned/.",
        ".gameexplorer/ contains upload and extraction staging, operation scratch space and trash."
      ]
    },
    {
      "dot": "emerald",
      "title": "Demo and deployment",
      "items": [
        "The Vercel demo selects the same React app with browser-memory adapters and no backend service.",
        "The release workflow publishes a GHCR image; deploy/truenas/compose.yaml configures the TrueNAS Custom App."
      ]
    }
  ]

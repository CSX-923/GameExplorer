  "cards": [
    {
      "dot": "cyan",
      "title": "Normal path",
      "items": [
        "Archives are extracted before their files are checked against the selected console.",
        "A compatible upload waits at Confirm until the user commits it into the library; Done means the files were stored.",
        "A raw file can skip extraction and move straight from Uploaded to validation."
      ]
    },
    {
      "dot": "amber",
      "title": "Branches and recovery",
      "items": [
        "Multi-volume uploads wait until the set is complete; extra parts merge into the first volume job.",
        "Encrypted archives pause at Needs password and return to Extracting after a password is submitted.",
        "Changing the console from Invalid reruns validation and can return the job to Confirm. A failed commit can also roll back to Confirm."
      ]
    },
    {
      "dot": "rose",
      "title": "Other outcomes",
      "items": [
        "An upload with no console goes to Unassigned instead of a console folder.",
        "An Invalid upload can be set aside in Unassigned or sent to trash.",
        "Failed marks a processing error and has no way out. Done and Unassigned are the other terminal outcomes."
      ]
    },
    {
      "dot": "amber",
      "title": "Not drawn",
      "items": [
        "Set aside also offers the trash, restorable into Unassigned.",
        "Changing the console from Confirm can make the files invalid again.",
        "A commit that fails is undone and returns to Confirm; any step can fail or be cancelled.",
        "Storing (committing) moves every file in one journaled operation, undone if it fails."
      ]
    }
  ]
